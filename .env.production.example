# Copy to .env.production next to compose.production.yaml and fill in APP_KEY and APP_URL.
# Generate the key with:
#   docker compose -f compose.production.yaml run --rm --no-deps --entrypoint php app artisan key:generate --show

APP_NAME="Therapie Aktiv Register"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://192.168.1.3:8080

APP_LOCALE=de
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=/srv/data/database.sqlite
DB_BACKUP_PATH=/srv/data/backups
DB_BUSY_TIMEOUT=5000

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
